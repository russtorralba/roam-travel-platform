rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function validUsername(username) {
      return username is string && username.matches('^[a-z0-9_]{3,20}$');
    }

    function validProfileShape(profile, uid) {
      return profile.keys().hasOnly(['uid', 'username', 'displayName', 'createdAt', 'updatedAt'])
        && profile.keys().hasAll(['uid', 'username', 'displayName', 'createdAt', 'updatedAt'])
        && profile.uid == uid
        && validUsername(profile.username)
        && profile.displayName is string
        && profile.displayName.size() >= 1
        && profile.displayName.size() <= 60;
    }

    function validNewProfile(profile, uid) {
      return validProfileShape(profile, uid)
        && profile.createdAt == request.time
        && profile.updatedAt == request.time;
    }

    function validUpdatedProfile(profile, uid) {
      return validProfileShape(profile, uid)
        && profile.createdAt == resource.data.createdAt
        && profile.updatedAt == request.time;
    }

    function validDraftDestination(destinationId) {
      return destinationId in ['palawan', 'kyoto', 'ubud', 'sagada', 'marrakesh'];
    }

    function validDraftCategory(category) {
      return category in ['', 'Coastlines', 'Culture', 'Mountains', 'Food & markets', 'Slow travel'];
    }

    function validDraftCover(cover) {
      return cover in [
        'https://images.unsplash.com/photo-1518509562904-e7ef99cdcc86?auto=format&fit=crop&w=900&q=85',
        'https://images.unsplash.com/photo-1493976040374-85c8e12f0c0e?auto=format&fit=crop&w=900&q=85',
        'https://images.unsplash.com/photo-1537996194471-e657df975ab4?auto=format&fit=crop&w=900&q=85',
        'https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?auto=format&fit=crop&w=900&q=85',
        'https://images.unsplash.com/photo-1548013146-72479768bada?auto=format&fit=crop&w=900&q=85',
        '/images/cathedral-cave-clean.png'
      ];
    }

    function validDraftDate(travelDate) {
      return travelDate == '' || travelDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function emailVerified() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function validJourneyContent(journey, uid) {
      return journey.ownerUid == uid
        && journey.title is string
        && journey.title.size() >= 1
        && journey.title.size() <= 100
        && journey.description is string
        && journey.description.size() >= 1
        && journey.description.size() <= 1000
        && validDraftDestination(journey.destinationId)
        && validDraftCategory(journey.category)
        && validDraftCover(journey.cover)
        && journey.travelDate is string
        && validDraftDate(journey.travelDate);
    }

    function validDraftShape(draft, uid) {
      return draft.keys().hasOnly(['ownerUid', 'title', 'destinationId', 'category', 'description', 'cover', 'travelDate', 'status', 'createdAt', 'updatedAt'])
        && draft.keys().hasAll(['ownerUid', 'title', 'destinationId', 'category', 'description', 'cover', 'travelDate', 'status', 'createdAt', 'updatedAt'])
        && validJourneyContent(draft, uid)
        && draft.status == 'draft';
    }

    function validPublishedJourneyShape(journey, uid) {
      return journey.keys().hasOnly(['ownerUid', 'title', 'destinationId', 'category', 'description', 'cover', 'travelDate', 'status', 'createdAt', 'updatedAt', 'authorUsername', 'authorDisplayName', 'publishedAt'])
        && journey.keys().hasAll(['ownerUid', 'title', 'destinationId', 'category', 'description', 'cover', 'travelDate', 'status', 'createdAt', 'updatedAt', 'authorUsername', 'authorDisplayName', 'publishedAt'])
        && validJourneyContent(journey, uid)
        && journey.status == 'published'
        && validUsername(journey.authorUsername)
        && journey.authorDisplayName is string
        && journey.authorDisplayName.size() >= 1
        && journey.authorDisplayName.size() <= 60;
    }

    function matchesAuthenticatedProfile(journey, uid) {
      return exists(/databases/$(database)/documents/profiles/$(uid))
        && get(/databases/$(database)/documents/profiles/$(uid)).data.username == journey.authorUsername
        && get(/databases/$(database)/documents/profiles/$(uid)).data.displayName == journey.authorDisplayName;
    }

    function matchingUsernameReservation(username, uid) {
      return existsAfter(/databases/$(database)/documents/usernames/$(username))
        && getAfter(/databases/$(database)/documents/usernames/$(username)).data.uid == uid
        && getAfter(/databases/$(database)/documents/usernames/$(username)).data.username == username;
    }

    match /profiles/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if false;
      allow create: if signedIn()
        && request.auth.uid == uid
        && validNewProfile(request.resource.data, uid)
        && matchingUsernameReservation(request.resource.data.username, uid);
      allow update: if signedIn()
        && request.auth.uid == uid
        && validUpdatedProfile(request.resource.data, uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'updatedAt'])
        && matchingUsernameReservation(resource.data.username, uid);
      allow delete: if false;
    }

    match /usernames/{username} {
      allow read: if false;
      allow create: if signedIn()
        && validUsername(username)
        && request.resource.data.keys().hasOnly(['uid', 'username', 'createdAt'])
        && request.resource.data.keys().hasAll(['uid', 'username', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username == username
        && request.resource.data.createdAt == request.time
        && existsAfter(/databases/$(database)/documents/profiles/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.username == username;
      allow update, delete: if false;
    }

    match /drafts/{draftId} {
      allow get, list: if resource.data.status == 'published'
        || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if signedIn()
        && validDraftShape(request.resource.data, request.auth.uid)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if (
          signedIn()
          && resource.data.ownerUid == request.auth.uid
          && resource.data.status == 'draft'
          && validDraftShape(request.resource.data, request.auth.uid)
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'destinationId', 'category', 'description', 'cover', 'travelDate', 'updatedAt'])
        ) || (
          emailVerified()
          && resource.data.ownerUid == request.auth.uid
          && resource.data.status == 'draft'
          && validPublishedJourneyShape(request.resource.data, request.auth.uid)
          && matchesAuthenticatedProfile(request.resource.data, request.auth.uid)
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.publishedAt == request.time
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'authorUsername', 'authorDisplayName', 'publishedAt', 'updatedAt'])
        ) || (
          emailVerified()
          && resource.data.ownerUid == request.auth.uid
          && resource.data.status == 'published'
          && validPublishedJourneyShape(request.resource.data, request.auth.uid)
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'destinationId', 'category', 'description', 'cover', 'travelDate', 'updatedAt'])
        ) || (
          emailVerified()
          && resource.data.ownerUid == request.auth.uid
          && resource.data.status == 'published'
          && validDraftShape(request.resource.data, request.auth.uid)
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'authorUsername', 'authorDisplayName', 'publishedAt', 'updatedAt'])
        );
      allow delete: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && (resource.data.status == 'draft' || emailVerified());
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
